{
  "name": "@tsci/techmannih.pd1180-epr",
  "version": "0.3.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "PD1180-EPR \u2014 NEMA 34 Smart Motor-Mounted Stepper Controller with USB-C PD 3.1 EPR",
  "homepage": "https://tscircuit.com/techmannih/NEMA-34-Smart-Motor-Mounted-Stepper-Controller",
  "repository": {
    "type": "git",
    "url": "https://github.com/techmannih/pd1180-epr.git"
  },
  "main": "index.circuit.tsx",
  "scripts": {
    "dev": "bun run check:toolchain && tsci dev release/circuit.json",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:pcb",
    "build:pcb": "bun scripts/refresh-routed-preview.mjs",
    "check:netlist": "bun scripts/check-netlist.mjs",
    "check:placement": "tsci check placement dist/index/circuit.json",
    "check:schematic": "tsci check schematic-placement dist/index/circuit.json",
    "check:source-schematic": "bun scripts/check-source-schematic.mjs",
    "check:schematic-style": "bun scripts/check-schematic-style.mjs",
    "check:routing": "tsci check routing-difficulty dist/index/circuit.json",
    "check:shorts": "tsci check shorts dist/index/circuit.json",
    "start": "bun run dev",
    "build:preview": "tsci build index.circuit.tsx --svgs --routing-disabled --disable-parts-engine",
    "check:stock": "bun scripts/check-stock.mjs",
    "check:alternatives": "bun scripts/check-alternatives.mjs",
    "sync:docs": "bun scripts/sync-generated-docs.mjs",
    "check:assembly": "bun scripts/check-assembly.mjs",
    "check:decoupling": "bun scripts/check-decoupling.mjs",
    "check:release": "bun scripts/check-release.mjs && bun run check:delivery",
    "export:assembly": "bun scripts/export-assembly.mjs",
    "export:kicad-route": "bun scripts/export-kicad-route.mjs",
    "normalize:kicad-parity": "bun scripts/normalize-kicad-parity.mjs",
    "build:handoff": "bun run verify && bun run export:assembly",
    "verify": "bun scripts/verify.mjs --routed",
    "check": "bun run verify",
    "export:previews": "bun scripts/export-previews.mjs",
    "check:local-copper": "bun scripts/check-local-copper.mjs",
    "check:route-complete": "bun run check:kicad-drc",
    "check:kicad-drc": "bun scripts/check-kicad-drc.mjs",
    "import:routed-kicad": "bun scripts/import-routed-kicad.mjs",
    "export:manufacturing": "bun scripts/export-manufacturing.mjs",
    "snapshot": "tsci snapshot index.circuit.tsx --disable-parts-engine",
    "snapshot:update": "tsci snapshot index.circuit.tsx --update --disable-parts-engine",
    "snapshot:3d": "tsci snapshot index.circuit.tsx --3d --camera-preset top-left-corner --disable-parts-engine",
    "snapshot:3d:update": "tsci snapshot index.circuit.tsx --update --3d --camera-preset top-left-corner --disable-parts-engine",
    "verify:preview": "bun scripts/verify.mjs",
    "check:geometry": "bun scripts/check-local-copper.mjs",
    "check:power-routing": "bun scripts/check-power-routing.mjs",
    "check:standards": "bun scripts/check-board-standards.mjs",
    "check:routing-fingerprint": "bun scripts/check-routing-fingerprint.mjs",
    "update:routing-fingerprint": "bun scripts/check-routing-fingerprint.mjs --update",
    "check:script-catalog": "bun scripts/check-script-catalog.mjs",
    "check:delivery": "bun scripts/check-delivery.mjs",
    "check:toolchain": "bun scripts/check-toolchain.mjs",
    "check:cloud-package": "bun scripts/check-cloud-package.mjs",
    "check:import-previews": "bun scripts/check-import-previews.mjs",
    "generate:cloud-viewer": "bun scripts/generate-cloud-viewer.mjs",
    "check:cloud-viewer": "bun scripts/check-cloud-viewer.mjs",
    "check:feature-parity": "bun scripts/check-feature-parity.mjs",
    "check:mounting-template": "bun scripts/generate-mounting-template.mjs --check",
    "normalize:svgs": "bun scripts/normalize-generated-svgs.mjs",
    "generate:firmware-pins": "bun scripts/generate-firmware-pins.mjs",
    "check:firmware-pins": "bun scripts/generate-firmware-pins.mjs --check",
    "check:firmware": "bun scripts/check-firmware.mjs",
    "export:release": "bun scripts/export-release.mjs",
    "generate:mounting-template": "bun scripts/generate-mounting-template.mjs",
    "review": "bun run check:stock && bun run check:alternatives && bun run verify && bun run export:previews && bun run export:release && bun run check:cloud-viewer && bun run check:review",
    "build:firmware": "bun scripts/build-firmware.mjs",
    "check:firmware-target": "bun scripts/build-firmware.mjs --check",
    "check:operating-mode": "bun scripts/check-operating-mode.mjs",
    "check:critical-copper": "bun scripts/check-critical-copper.mjs",
    "check:review": "bun scripts/check-release.mjs --review && bun run check:delivery",
    "check:usb-reference": "bun scripts/check-usb-reference.mjs",
    "check:power-audit": "bun scripts/power-audit.mjs --check"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.2.18",
    "circuit-json-to-kicad": "0.0.230",
    "circuit-to-svg": "0.0.433",
    "jszip": "3.10.1",
    "kicad-to-circuit-json": "0.0.117",
    "polygon-clipping": "0.15.7",
    "tscircuit": "0.0.2774",
    "typescript": "5.9.2"
  },
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics",
    "pd1180",
    "usb-c-pd",
    "stepper"
  ]
}
