{
  "name": "@tsci/pd1180-epr",
  "version": "0.3.0",
  "private": true,
  "description": "PD1180-EPR — NEMA 34 Smart Motor-Mounted Stepper Controller with USB-C PD 3.1 EPR",
  "main": "index.circuit.tsx",
  "scripts": {
    "dev": "tsci dev index.circuit.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:preview",
    "check:netlist": "bun scripts/check-netlist.mjs",
    "check:placement": "tsci check placement dist/index/circuit.json",
    "check:schematic": "tsci check schematic-placement dist/index/circuit.json",
    "check:routing": "tsci check routing-difficulty dist/index/circuit.json",
    "check:shorts": "tsci check shorts dist/index/circuit.json",
    "start": "tsci dev index.circuit.tsx",
    "build:preview": "tsci build index.circuit.tsx --svgs --routing-disabled --disable-parts-engine",
    "check:stock": "bun scripts/check-stock.mjs",
    "check:alternatives": "bun scripts/check-alternatives.mjs",
    "sync:docs": "bun scripts/sync-generated-docs.mjs",
    "check:assembly": "bun scripts/check-assembly.mjs",
    "check:decoupling": "bun scripts/check-decoupling.mjs",
    "check:release": "bun scripts/check-release.mjs",
    "export:assembly": "bun scripts/export-assembly.mjs",
    "build:handoff": "bun run verify && bun run export:assembly",
    "verify": "bun scripts/verify.mjs --routed",
    "check": "bun run verify",
    "export:previews": "bun scripts/export-previews.mjs",
    "check:local-copper": "bun scripts/check-local-copper.mjs",
    "check:route-complete": "bun run check:kicad-drc",
    "check:kicad-drc": "bun scripts/check-kicad-drc.mjs",
    "import:routed-kicad": "bun scripts/import-routed-kicad.mjs",
    "export:manufacturing": "bun scripts/export-manufacturing.mjs",
    "snapshot": "tsci snapshot index.circuit.tsx --disable-parts-engine",
    "snapshot:update": "tsci snapshot index.circuit.tsx --update --disable-parts-engine",
    "snapshot:3d": "tsci snapshot index.circuit.tsx --3d --camera-preset top-left-corner --disable-parts-engine",
    "snapshot:3d:update": "tsci snapshot index.circuit.tsx --update --3d --camera-preset top-left-corner --disable-parts-engine",
    "verify:preview": "bun scripts/verify.mjs",
    "check:geometry": "bun scripts/check-local-copper.mjs",
    "check:power-routing": "bun scripts/check-power-routing.mjs",
    "generate:firmware-pins": "bun scripts/generate-firmware-pins.mjs",
    "check:firmware-pins": "bun scripts/generate-firmware-pins.mjs --check",
    "check:firmware": "bun scripts/check-firmware.mjs",
    "export:release": "bun scripts/export-release.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.2.18",
    "circuit-to-svg": "0.0.433",
    "circuit-json-to-kicad": "0.0.230",
    "jszip": "3.10.1",
    "kicad-to-circuit-json": "0.0.117",
    "polygon-clipping": "0.15.7",
    "tscircuit": "0.0.2687",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@tsci/TTangZH.STM32G0B1CBT6": "0.1.0"
  },
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics",
    "pd1180",
    "usb-c-pd",
    "stepper"
  ]
}
