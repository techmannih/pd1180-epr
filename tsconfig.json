{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "react",
      "@tscircuit/core",
      "node"
    ]
  },
  "include": [
    "index.circuit.tsx",
    "imports/**/*.tsx"
  ]
}