  ],
  "features": [
    {
      "id": "separate_usb",
      "feature": "Separate POWER and DATA ports",
      "status": "implemented",
      "evidence": "docs/usb-pd-architecture.md",
      "detail": "J1 EPR power; J10 independent USB DATA/MCU supply. Two CC Rd on DATA. Physical compliance remains a separate gate."
    },
    {
      "id": "pd_voltage",
      "feature": "Software-selectable PD voltage",
      "status": "intentional_difference",
      "evidence": "docs/pd-configuration.json",
      "detail": "References select 5\u201320 V / 5\u201328 V. This motor design is fixed 48 V / 5 A EPR; firmware rejects other contracts. No arbitrary-voltage UI is promised. TI image remains missing."
    },
    {
      "id": "power_protection",
      "feature": "Input protection and reverse blocking",
      "status": "implemented",
      "evidence": "engineering/power-audit.json",
      "detail": "eFuse, independent power permit, reverse-blocked logic supplies and motor-side brake backup. Limits use this board\u2019s own ratings."
    },
    {
      "id": "driver",
      "feature": "Motor driver and local thermal paths",
      "status": "implemented",
      "evidence": "docs/native-decoupling-check.json",
      "detail": "Retained TMC5160A/external bridges by user decision; 12 V VSA supply and 58 filled/capped via-in-pad locations. Target-current thermal qualification is open."
    },
    {
      "id": "motor_connector",
      "feature": "Keyed motor connector and mating cable",
      "status": "implemented",
      "evidence": "docs/motor-harness.md",
      "detail": "JST VH retained for higher-current target. VHR-4N, SVH-41T-P1.1 and 16 AWG pigtails defined; actual harness not built/tested."
    },
    {
      "id": "temperature",
      "feature": "Temperature readout and motor inhibition",
      "status": "implemented",
      "evidence": "firmware/README.md",
      "detail": "TMP102 + U33 hardware inhibit; missing/stale sensor blocks firmware. NEMA17 has software-only board-temperature response; do not remove our independent inhibit."
    },
    {
      "id": "phase_current",
      "feature": "Actual signed winding-current readings",
      "status": "implemented",
      "evidence": "docs/critical-copper-check.json",
      "detail": "INA240A1 \u00d72, 5 m\u03a9 telemetry shunts, 100 mV/A nominal. Independent 33 m\u03a9 regulation shunts. Calibration and PWM sampling remain open."
    },
    {
      "id": "rgb",
      "feature": "Visible multicolor status",
      "status": "implemented",
      "evidence": "docs/indicators.md",
      "detail": "D16 common-anode RGB, U35 reset-controlled TCA9538 sinks and current limiting. PC13 controls reset without consuming industrial pins; host-tested fault/power/suspend behavior. Optical and powered qualification remain open."
    },
    {
      "id": "buzzer",
      "feature": "Audible fault alert",
      "status": "implemented",
      "evidence": "docs/indicators.md",
      "detail": "BZ1 active buzzer, Q26 low-side driver, gate pulldown, clamp and local bulk supply. Reset or communication failure silences the driver. Audible/current qualification remains open."
    },
    {
      "id": "power_indicator",
      "feature": "Independent logic-power indication",
      "status": "implemented",
      "evidence": "docs/indicators.md",
      "detail": "D17 and R128 independently indicate board V3V3; USB-only MCU power does not light it. Included in the additional 75 mA logic-rail allocation."
    },
    {
      "id": "power_probes",
      "feature": "Dedicated PD / VMOTOR / GND measurement pads",
      "status": "implemented",
      "evidence": "docs/pd-programming.md",
      "detail": "Top TP_PD_VBUS, TP_VMOTOR and TP_PWR_GND added with five EEPROM fixture pads; total 19 service pads. Fixture construction and physical probe access remain to be qualified."
    },
    {
      "id": "encoder",
      "feature": "Centered underside optional encoder",
      "status": "implemented",
      "evidence": "docs/assembly-check.json",
      "detail": "U18 at (0,0), bottom with C52/C53; all three DNP, excluded from fitted BOM/CPL/paste. AS5047P SPI retained instead of AS5600 I2C."
    },
    {
      "id": "encoder_mechanics",
      "feature": "Shaft magnet / holder / working gap",
      "status": "open",
      "evidence": "docs/motor-assembly.md",
      "detail": "Single-shaft 34HS31-6004S1 has no documented rear rotating-shaft attachment. DNP footprint is complete; usable shaft feedback is not."
    },
    {
      "id": "programming",
      "feature": "MCU reset and programming recovery",
      "status": "implemented",
      "evidence": "firmware/README.md",
      "detail": "STM32 internal flash, SWD/NRST service pads and SW1; RP2040 BOOTSEL/UF2 circuitry is not copied. USB CDC setup is not a firmware flasher."
    },
    {
      "id": "pd_programming",
      "feature": "Blank PD EEPROM programming and approved image",
      "status": "open",
      "evidence": "docs/pd-programming.md",
      "detail": "U36 isolates both controller I2Cc wires. EEPROM-side SDA/SCL, VREF, GND and isolation pads plus a fixed-5 V blank-board procedure are implemented. TI full-flash image, built fixture and readback/APP-boot evidence remain missing."
    },
    {
      "id": "industrial",
      "feature": "Retain only defined external functions",
      "status": "open",
      "evidence": "docs/connector-harnesses.md",
      "detail": "J7 and remaining STEP/DIR/enable/home/limit stages removed from current TSX. Onboard SPI ramp and local START/STOP replace the undefined external command equipment; native copper refresh pending."
    },
    {
      "id": "mechanics",
      "feature": "Motor mounting, holes and cable/tool access",
      "status": "open",
      "evidence": "docs/motor-assembly-check.json",
      "detail": "Four PCB drills and exact motor-axis alignment retained. Unsupported front-post/adapter/clamp hardware withdrawn; no rear fastener dimensions invented. Alignment-only preview, physical mounting and retention unverified."
    },
    {
      "id": "thermal",
      "feature": "Heatsink, enclosure and brake load",
      "status": "open",
      "evidence": "docs/power-validation.md",
      "detail": "References\u2019 thermal vias/clearance method applies; their motor current, bulk capacitor and heatsink assumptions do not. Qualified thermal envelope and external brake cooling are missing."
    },
    {
      "id": "firmware",
      "feature": "Executable motor / interface application",
      "status": "open",
      "evidence": "firmware/README.md",
      "detail": "Executable bounded local START/STOP/internal SPI ramp path implemented and host-tested; shipped STM32 binary remains locked pending TI image and powered qualification. Reference READMEs include no executable motion firmware."
    },
    {
      "id": "markings",
      "feature": "Visible labels, branding and net names",
      "status": "implemented",
      "evidence": "board-markings.tsx",
      "detail": "Knockout POWER/DATA labels, connector markings and explicit route net identities already checked; every new service pad needs its own visible label."
    },
    {
      "id": "fabrication",
      "feature": "Sourcing, assembly files and routed DRC",
      "status": "open",
      "evidence": "docs/verification.json",
      "detail": "Current source ECO invalidates older native routing/release evidence. New route, full review and stock approval are pending; no orderable release."
    }
  ],
