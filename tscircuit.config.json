{
  "$schema": "https://cdn.jsdelivr.net/npm/@tscircuit/cli/types/tscircuit.config.schema.json",
  "mainEntrypoint": "index.circuit.tsx",
  "includeBoardFiles": [
    "index.circuit.tsx"
  ],
  "ignoredFiles": [
    ".github/**",
    "checks/**",
    "dist/**",
    "build/**",
    "release/**",
    "__snapshots__/**",
    "docs/**",
    "engineering/**",
    "firmware/**",
    "firmware/build/**",
    "previews/**",
    "routing/**",
    "scripts/**",
    "sourcing/**",
    "*.log"
  ],
  "build": {
    "workerTimeoutMs": 2700000,
    "routingDisabled": true
  }
}
